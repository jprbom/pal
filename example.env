# ------------------------------------------
# Required: API Keys
# ------------------------------------------

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------
# Optional: Web Research (Parallel — Researcher agent)
# ------------------------------------------

# Parallel API key for web search + content extraction.
# Enables the Researcher agent with parallel_search and parallel_extract.
# When configured, ingest_url auto-fetches full page content.
# Without this key, the Researcher is disabled and ingest creates stubs.
# Get from: https://parallel.ai
# PARALLEL_API_KEY=

# ------------------------------------------
# Optional: Web Search (Exa — Navigator + Linter)
# ------------------------------------------

# Exa web search is available by default via free MCP server.
# Used by Navigator and Linter for general web search.
# Adding an API key enables authenticated access with higher limits.
# Get from: https://exa.ai
# EXA_API_KEY=

# ------------------------------------------
# Optional: Google OAuth (Gmail + Calendar)
# ------------------------------------------

# All 3 are required together — set all or none.
# See docs/GOOGLE_AUTH.md for the full setup guide.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PROJECT_ID=

# ------------------------------------------
# Optional: Slack
# ------------------------------------------

# Create app from the manifest in docs/SLACK_CONNECT.md.
# Bot token (xoxb-...) from the Install App page.
# Signing secret from Basic Information → App Credentials.
# SLACK_TOKEN=
# SLACK_SIGNING_SECRET=

# ------------------------------------------
# Optional: Git Sync (GitHub-backed context)
# ------------------------------------------

# Both required together. Enables git-backed persistence for context/.
# No Railway volume needed — git is the persistence layer.
# Fine-grained PAT with Contents (Read and write) on the context repo.
# GITHUB_ACCESS_TOKEN=
# PAL_REPO_URL=https://github.com/your-user/pal.git

# ------------------------------------------
# Context Directory
# ------------------------------------------

# Where Pal reads/writes user files, raw sources, and the wiki.
# Default: ./context (relative to project root)
# PAL_CONTEXT_DIR=./context

# ------------------------------------------
# Database
# ------------------------------------------

# Defaults work out of the box with Docker Compose.
# Only change these if you're using an external database.
# DB_USER=ai
# DB_PASS=ai
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=ai

# ------------------------------------------
# Server
# ------------------------------------------

# API port. Default: 8000.
# PORT=8000

# Runtime environment.
#   dev  → hot reload, local scheduler URL (http://127.0.0.1:8000)
#   prd  → RBAC authorization enabled, requires JWT_VERIFICATION_KEY
# RUNTIME_ENV=prd

# Scheduler callback URL for production deployments.
# In dev mode, defaults to http://127.0.0.1:8000.
# AGENTOS_URL=https://pal.example.com

# ------------------------------------------
# Production: Security
# ------------------------------------------

# RBAC is enabled automatically when RUNTIME_ENV=prd.
# Generate a key pair at os.agno.com → Settings.
# Paste the public key below (including BEGIN/END lines).
# See: https://docs.agno.com/agent-os/security/overview
# See: https://docs.agno.com/agent-os/security/rbac
# JWT_VERIFICATION_KEY=

# ------------------------------------------
# Production: Deployment
# ------------------------------------------

# Local dev uses .env (Docker Compose default).
# Production uses .env.production (Railway via railway_env.sh).
#
# Setup:
#   Local:       cp example.env .env
#   Production:  cp example.env .env.production
#
# Deploy to Railway:
#   First time:  ./scripts/railway_up.sh
#   Redeploy:    ./scripts/railway_redeploy.sh
#   Sync env:    ./scripts/railway_env.sh (reads .env.production)
#
# Secure your deployment:
#   1. Set RUNTIME_ENV=prd
#   2. Set JWT_VERIFICATION_KEY from os.agno.com
#   3. Connect at os.agno.com → Add OS → your deployed URL
